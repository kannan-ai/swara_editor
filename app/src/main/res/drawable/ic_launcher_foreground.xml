<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. Ambient Neon Glow Aura Path -->
    <path
        android:pathData="M66,28 C50,28 38,34 38,46 C38,58 70,50 70,62 C70,74 58,80 42,80 M48,42 L68,54 L48,66 Z"
        android:strokeWidth="12"
        android:strokeColor="#3300E5FF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- 2. Main Continuous Stylized "S" Timeline Ribbon with Gradient -->
    <path
        android:pathData="M68,28 C52,28 38,34 38,46 C38,58 70,50 70,62 C70,74 56,80 40,80"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="38"
                android:startY="28"
                android:endX="70"
                android:endY="80"
                android:type="linear">
                <item android:color="#FF00E5FF" android:offset="0.0"/>
                <item android:color="#FFD0BCFF" android:offset="0.5"/>
                <item android:color="#FFFF4081" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3. Integrated Central Play Triangle Glyph -->
    <path
        android:pathData="M48,42 L68,54 L48,66 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="48"
                android:startY="42"
                android:endX="68"
                android:endY="66"
                android:type="linear">
                <item android:color="#FF00E5FF" android:offset="0.0"/>
                <item android:color="#FFD0BCFF" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- 4. Top & Bottom Cinematic Timeline Frame Accents -->
    <path
        android:pathData="M32,20 L76,20 M32,88 L76,88"
        android:strokeWidth="3"
        android:strokeColor="#66D0BCFF"
        android:strokeLineCap="round" />
    <path
        android:pathData="M42,17 L42,23 M66,17 L66,23 M42,85 L42,91 M66,85 L66,91"
        android:strokeWidth="2.5"
        android:strokeColor="#8000E5FF"
        android:strokeLineCap="round" />

</vector>
